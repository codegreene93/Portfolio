---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";

---

<Layout title="Footer">
<div class="footer">

    <div class="left-align">

        <p>Amy Greene</p>

    </div>

    <div class="right-align">
        <Icon class="icon" name={"mdi:github"} />
        <Icon class="icon" name={"mdi:linkedin"} />

    </div>

</div>

    <style>
        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            color: #9A8060;
            border-top: 1px solid #9A8060;
            z-index: 100;
        }
    </style>
</Layout>